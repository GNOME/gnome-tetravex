msgid "Tetravex"
msgstr "Tetravex"

#: data/org.gnome.Tetravex.desktop.in.in:3
msgid "Complete the puzzle by matching numbered tiles"
msgstr "Каб рашыць галаваломку, сумяшчайце аднолькавыя лічбы на плітках"

