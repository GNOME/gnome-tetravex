msgid "Tetravex"
msgstr "Tetravex"

#
#: data/org.gnome.Tetravex.desktop.in.in:3
msgid "Complete the puzzle by matching numbered tiles"
msgstr "Fullfør puslespelet ved å flytta på nummererte fliser"

#. TRANSLATORS: Do NOT translate or localize the semicolons!
#. The list MUST also end with a semicolon!
#. Search terms to find this application.
#: data/org.gnome.Tetravex.desktop.in.in:7
msgid "game;logic;board;"
msgstr "spel;logikk;brett;"

#: data/org.gnome.Tetravex.gschema.xml.in:12
msgid "The size of the playing grid"
msgstr "Storleiken på spelefeltet"

#: data/org.gnome.Tetravex.gschema.xml.in:16
msgid "Saved game, if any"
msgstr "Lagra spel, viss det finst"

#: data/org.gnome.Tetravex.gschema.xml.in:20
msgid "The name of the current theme"
msgstr "Namnet på gjeldande tema"

#
